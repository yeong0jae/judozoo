    {
      "id": 5,
      "type": "timeseries",
      "title": "시간대별 고유 방문자",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "고유 IP",
          "expr": "count(sum by (ip) (count_over_time({service=\"frontend\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <_> \"<_>\" \"<ua>\" \"<_>\"` | __error__=\"\" | status =~ \"[0-9]{3}\" | ip !~ \"172\\\\..*\" | path !~ \"/assets/.*\" | path != \"/favicon.ico\" | path !~ \"/health.*\" [1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "일별 신규 가입",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "judozoo-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "judozoo-mysql"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT DATE(created_at) AS time, COUNT(*) AS '신규 가입' FROM app_user WHERE $__timeFilter(created_at) GROUP BY DATE(created_at) ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "화면별 조회수",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "legendFormat": "{{path}}",
          "expr": "topk(10, sum by (path) (count_over_time({service=\"frontend\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <_> \"<_>\" \"<ua>\" \"<_>\"` | __error__=\"\" | status =~ \"[0-9]{3}\" | ip !~ \"172\\\\..*\" | path !~ \"/assets/.*\" | path != \"/favicon.ico\" | path !~ \"/health.*\" | path !~ \"/api/.*\" | method = \"GET\" [$__range])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "가입자",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",

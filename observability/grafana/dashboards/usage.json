      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "judozoo-mysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT email AS 이메일, created_at AS 가입, last_login_at AS '마지막 로그인' FROM app_user ORDER BY last_login_at DESC LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},

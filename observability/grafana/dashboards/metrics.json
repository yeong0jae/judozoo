            "uid": "prometheus"
          },
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "디스크 여유",
      "datasource": {
        "type": "prometheus",

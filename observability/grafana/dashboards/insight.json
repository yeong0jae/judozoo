    {
      "id": 15,
      "type": "timeseries",
      "title": "시간대별 생성",
      "datasource": {
        "type": "mysql",
        "uid": "judozoo-mysql"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "judozoo-mysql"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT DATE_FORMAT(generated_at, '%Y-%m-%d %H:00:00') - INTERVAL 9 HOUR AS time, SUM(published = 1 AND explained = 1) AS '설명', SUM(published = 1 AND explained = 0) AS '설명 없음', SUM(published = 0) AS '거절' FROM stock_reason WHERE $__timeFilter(generated_at) GROUP BY 1 ORDER BY 1;"
        }
      ],
      "description": "한 시간 단위. 국내 08:30~20:00, 해외 23:00~07:00(서머타임 중)에 쌓이고 정해진 시각에 튄다. 반환 time만 9시간 뺀다 — Grafana가 DATETIME을 UTC로 읽는다(usage.json과 같다)."
    },
    {
      "id": 16,
      "type": "table",
      "title": "최근 만든 사유 50건",
      "datasource": {
        "type": "mysql",
        "uid": "judozoo-mysql"
      },
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "judozoo-mysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DATE_FORMAT(generated_at, '%m-%d %H:%i') AS 시각, region AS 시장, name AS 종목, `trigger` AS 트리거, CASE WHEN published = 0 THEN '거절' WHEN explained = 0 THEN '설명 없음' ELSE '설명' END AS 결과, reason AS 사유, JSON_LENGTH(evidence) AS 근거, JSON_LENGTH(related) AS 관련, error AS 오류 FROM stock_reason ORDER BY id DESC LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "대시보드 범위와 무관하게 최근 50건. 기사 제목·링크는 evidence·related 칸(JSON)에 있다."
    },
    {
      "id": 17,
      "type": "table",
      "title": "최근 7일 거절 사유",
      "datasource": {
        "type": "mysql",
        "uid": "judozoo-mysql"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "judozoo-mysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(LEFT(error, 60), '(없음)') AS 오류, COUNT(*) AS 건수 FROM stock_reason WHERE published = 0 AND generated_at >= CURDATE() - INTERVAL 7 DAY GROUP BY 1 ORDER BY 2 DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },

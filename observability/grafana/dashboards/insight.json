          "expr": "sum(increase(llm_search_queries_total[30d]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "그라운딩 검색어 수. Gemini 3 모델 합산 월 5,000회까지 무료, 이후 1,000회당 $14. 결제 월이 아니라 최근 30일이다.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "최근 30일 예상 비용",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(llm_tokens_total{kind=\"input\"}[30d])) * 0.75 + sum(increase(llm_tokens_total{kind=~\"output|thoughts\"}[30d])) * 3.75) / 1e6 + clamp_min(sum(increase(llm_search_queries_total[30d])) - 5000, 0) * 0.014",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "description": "메트릭으로 계산한 추정치. Gemini 3.8 Flash 입력 $0.75 · 출력(사고 포함) $3.75 / 100만 토큰(2026-12-31까지 할인가) + 검색 5,000회 초과분. 실제 청구는 GCP 결제 보고서가 기준이다.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"

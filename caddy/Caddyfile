# 도메인은 이미지에 박지 않고 환경변수로 받는다 (secrets/.env).
# 도메인이 바뀌거나 서브도메인이 늘어도 이미지를 다시 빌드하지 않아도 된다.
#
# 인증서는 DNS-01로 받는다. CLOUDFLARE_API_TOKEN은 Zone:DNS:Edit 권한이어야 한다.
(tls_dns) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

{$DOMAIN} {
	import tls_dns
	reverse_proxy frontend:3000
}

# Grafana는 Caddy를 거치지 않는다. IAP TCP 터널로만 붙는다 —
# `gcloud compute start-iap-tunnel <vm> 3000 --local-host-port=localhost:3000`.
# 공개 서브도메인을 두면 방화벽이 포트 단위라 로그인 화면이 인터넷에 노출되고,
# 그걸 막으려고 개인 IP 허용목록을 들고 다녀야 했다. 입구 자체를 없앴다.

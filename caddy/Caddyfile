# 도메인은 이미지에 박지 않고 환경변수로 받는다 (secrets/.env).
# 도메인이 바뀌거나 서브도메인이 늘어도 이미지를 다시 빌드하지 않아도 된다.
#
# 인증서는 DNS-01로 받는다. CLOUDFLARE_API_TOKEN은 Zone:DNS:Edit 권한이어야 한다.
(tls_dns) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

{$DOMAIN} {
	import tls_dns
	reverse_proxy frontend:3000
}

# Grafana는 공개 대상이 아니다. 방화벽은 포트 단위라 judozoo.com을 열면 이 서브도메인도
# 같이 열린다 — 알려진 소프트웨어의 로그인 화면을 인터넷에 노출하지 않으려고 여기서 막는다.
# Caddy가 엣지라 remote_ip가 실 클라이언트 IP다.
{$GRAFANA_DOMAIN} {
	import tls_dns
	@denied not remote_ip {$GRAFANA_ALLOWED_IPS}
	respond @denied 403
	reverse_proxy grafana:3000
}
